{
  "name": "railkit",
  "version": "0.1.0",
  "private": true,
  "description": "Governing framework for repos: owners, ratchets, agent skills, code-first gates",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:documentation": "node packs/js/documentation/check-documentation.js",
    "check:documentation:ownership": "node packs/js/documentation/check-documentation-ownership.js",
    "check:architecture": "node packs/js/architecture/check-architecture.js",
    "check:architecture:ratchet": "node packs/js/architecture/check-architecture-ratchet.js",
    "check:unused-export": "node packs/js/unused-export/check-unused-export.js",
    "check:editor-rules": "node adapters/cursor/check-always-on-rules.js --rules adapters/cursor/rules",
    "check:railkit": "node packs/js/check-umbrella.js && npm run check:editor-rules",
    "install:host": "node scripts/install/copy-kit-to-host.js",
    "test": "node --test scripts/install/copy-kit-to-host.test.js"
  }
}
